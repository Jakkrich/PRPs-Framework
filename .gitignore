# PRP Framework - gitignore

# ------------------------------
# 1. AUTO-CLAUDE (Logs & Trash)
# ------------------------------
# Logs & Status Files - Always Ignore
.auto-claude/logs/
.auto-claude/temp/
.auto-claude/worktrees/
.auto-claude-status
*.log

# Security & Secrets - CRITICAL IGNORE!
.security-key
.auto-claude-security.json

# ------------------------------
# 2. ARTIFACTS (KEEP THESE!)
# ------------------------------
# We want to track Plans, Specs, and Reports
# Do NOT uncomment these lines unless you want to ignore them
# .auto-claude/plans/
# .auto-claude/specs/
# .auto-claude/reports/

# ------------------------------
# 3. BACKEND & TOOLS
# ------------------------------
# Python Virtual Environments
PRPs-Framework/apps/backend/venv/
venv/
.venv/
env/

# Python Cache & Bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Node.js Dependencies (Future Proofing)
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# ------------------------------
# 4. IDE / EDITOR SETTINGS
# ------------------------------
# VS Code / Cursor (Optional: Adjust based on team policy)
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
# .cursor/ is usually kept, but personal configs can be ignored

# ------------------------------
# 5. OS Generated Files
# ------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ------------------------------
# 6. Documentation & Notes
# ------------------------------
# Keep folder structure but ignore content inside sensitive/messy notes
PRPs-Framework/_notes/*
!PRPs-Framework/_notes/.gitkeep
